# LLM endpoint. LM Studio's OpenAI-compatible server normally uses this URL.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b-claude-4.6-opus-uncensored-distilled
LLM_TIMEOUT=600
LLM_MAX_TOKENS=2048

# Runtime layout. Keep generated files under var/ so the repo stays clean.
AGENT_VAR_DIR=var
AGENT_WORKSPACE_DIR=var/workspace
AGENT_RUNS_DIR=var/agent_runs
AGENT_TEST_RUNS_DIR=var/test_runs
QDRANT_STORAGE_DIR=var/qdrant_storage

# Tool safety toggles. Leave disabled unless a run explicitly needs mutation.
AGENT_ALLOW_GIT_MUTATIONS=0
AGENT_ALLOW_HIGH_RISK_TERMINAL=0
DOCKER_MCP_ALLOW_MUTATION=0

# Optional MCP/service settings.
NPX_COMMAND=npx
CONTEXT7_API_KEY=
OBSIDIAN_VAULT_DIR=
ISSUE_DB_PATH=
LEDGER_PATH=
PLAYWRIGHT_BROWSERS_PATH=

# RAG/Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=my_agents_rag
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# Search providers. If no API key is set, search falls back to DuckDuckGo.
SEARCH_PROVIDER=duckduckgo
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
